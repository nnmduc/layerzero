# ==============================================================================
# LayerZero Studio — Environment Configuration Example
# Copy this file to `.env` if you wish to customize default ports or paths.
# ==============================================================================

# Port for the Python FastAPI backend (default: 8000)
LAYERZERO_PORT=8000

# Comma-separated allowed CORS origins (default: *)
LAYERZERO_CORS_ORIGINS=*

# Optional custom path to Bambu Studio system profiles directory
# Defaults to platform standard path (e.g., ~/Library/Application Support/BambuStudio/system/BBL on macOS)
# BBL_SYSTEM_DIR=/Users/yourname/Library/Application Support/BambuStudio/system/BBL

# Optional Apple Developer ID Application certificate for signing macOS .app / .dmg builds
# Leave unset or set to "-" for ad-hoc local signing
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
